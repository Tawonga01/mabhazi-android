{
  "cli": {
    "appVersionSource": "local"
  },
  "build": {
    "preview": {
      "distribution": "internal",
      "developmentClient": false,
      "credentialsSource": "remote",
      "autoIncrement": false,
      "environment": "preview",
      "pnpm": "10.26.1",
      "env": { "EXPO_PUBLIC_APP_VARIANT": "preview" },
      "android": { "buildType": "apk", "image": "latest" }
    },
    "production": {
      "distribution": "store",
      "developmentClient": false,
      "credentialsSource": "remote",
      "autoIncrement": false,
      "environment": "production",
      "pnpm": "10.26.1",
      "env": {
        "EXPO_PUBLIC_API_BASE_URL": "https://api.mabhazi.com"
      },
      "android": {
        "buildType": "app-bundle",
        "image": "latest"
      }
    }
  }
}
